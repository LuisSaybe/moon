{
  "name": "moon-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "check": "node node_modules/typescript-compiler/bin/tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prisma": "^7.10.0",
    "typescript": "~6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4"
  }
}
